OPENAI_API_KEY=pega_aqui_tu_clave_de_api
OPENAI_MODEL=gpt-6-luna
FDC_API_KEY=DEMO_KEY
# En Supabase: Connect > Session pooler. Reemplaza los campos de ejemplo.
# Codifica caracteres especiales de la contraseña para una URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Genera una clave aleatoria y usa el mismo valor en los backends del equipo.
NUTRISCAN_SECRET_KEY=pega_aqui_una_clave_aleatoria_privada
